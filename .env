# Email Configuration for DICTOLE Mental Health Foundation
# IMPORTANT: Use Gmail App Password (not regular password)
# Create Gmail App Password: https://myaccount.google.com/apppasswords
# Steps:
# 1. Go to https://myaccount.google.com/apppasswords
# 2. Select "Mail" for app and "Other (Custom name)" for device
# 3. Enter "DICTOLE Website" as name
# 4. Copy the 16-character password generated
# 5. Replace the password below with the app password

EMAIL_USER=dictolementalhealthfoundation@gmail.com
EMAIL_PASS=Mike2002!

# Server Configuration
PORT=3000
HOST=0.0.0.0

# Note: If you still get "server error", the Gmail App Password might be incorrect
# or 2-factor authentication might be blocking it.
